<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DotYjs</RootNamespace>
    <PackageId>DotYjs</PackageId>
    <Description>Pure .NET port of Yjs (CRDT), wire-compatible with the JavaScript yjs 13.x library.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotYjs.Tests" />
  </ItemGroup>

</Project>
