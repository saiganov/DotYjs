<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DotYjs.AspNetCore.Redis</RootNamespace>
    <PackageId>DotYjs.AspNetCore.Redis</PackageId>
    <Description>Redis pub/sub backplane for the DotYjs ASP.NET Core server (multi-node deployments).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotYjs.AspNetCore\DotYjs.AspNetCore.csproj" />
  </ItemGroup>

</Project>
