<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DotYjs.AspNetCore</RootNamespace>
    <PackageId>DotYjs.AspNetCore</PackageId>
    <Description>ASP.NET Core WebSocket server for DotYjs, compatible with the y-websocket client.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotYjs\DotYjs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotYjs.Tests" />
  </ItemGroup>

</Project>
